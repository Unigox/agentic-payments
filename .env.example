# Agentic Payments settings. Copy this file to .env and fill in the values.
# Never commit .env and never paste these values into a chat.

# Required. UNIGOX Partner API key, sent as the X-API-Key header.
# Issued after business onboarding at https://unigox.com/business.
# Without it the skill cannot place a transfer.
UNIGOX_API_KEY=

# Required. Private key of your UNIGOX partner wallet, 0x followed by 64 hex characters.
# Used only on this machine to sign escrow funding and refunds. It is never sent to UNIGOX.
# This key controls the wallet's whole balance: use a partner account that holds only
# what the agent is allowed to spend.
UNIGOX_WALLET_PRIVATE_KEY=

# Required. JSON-RPC URL of an XAI mainnet node (chain id 660279).
# Used only to read the partner wallet's USDC and USDT balance before a transfer is offered.
UNIGOX_XAI_RPC_URL=

# Required. Email of the one KYC-verified person this installation sends for.
# Registered with the Partner API as the sender. One installation serves one sender.
UNIGOX_SENDER_EMAIL=

# Optional. Base URL of the Partner API. Leave unset for production (https://api.unigox.com).
# Set to https://api-staging.unigox.com to test with a staging key.
# UNIGOX_API_URL=
